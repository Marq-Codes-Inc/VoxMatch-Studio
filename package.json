{
  "name": "voxmatch-studio",
  "version": "1.0.0",
  "description": "Professional audio/video editing software with advanced lyrics and subtitle synchronization.",
  "author": "Marq @ MarqCodesInc",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run electron:dev",
    "build": "tsc && vite build",
    "build:electron": "node electron/build.js",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"npm run electron\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder",
    "preview": "vite preview",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",

    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist dist-electron release node_modules/.vite",
    "clean:all": "rimraf dist dist-electron release node_modules"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.39",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.voxmatch.studio",
    "productName": "VoxMatch Studio",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "vxm",
        "name": "VoxMatch Project",
        "description": "VoxMatch Studio Project File",
        "icon": "public/assets/icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "public/assets/icon.ico",
      "target": ["nsis", "portable"]
    },
    "mac": {
      "icon": "public/assets/icon.icns",
      "target": ["dmg", "zip"],
      "category": "public.app-category.video",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "VoxMatch Project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.voxmatch.project"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.voxmatch.project",
            "UTTypeDescription": "VoxMatch Studio Project",
            "UTTypeConformsTo": ["public.data", "public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["vxm"]
            }
          }
        ]
      }
    },
    "linux": {
      "icon": "public/assets/icon.png",
      "target": ["AppImage", "deb"],
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/assets/icon.ico",
      "uninstallerIcon": "public/assets/icon.ico",
      "installerHeaderIcon": "public/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}